<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/color_subWinBG"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" >

        <FrameLayout
            android:id="@+id/FontApplyFrameLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="0dp">
            <Button
                android:id="@+id/FontApplyButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/button_color_selector"
                android:paddingStart="42dp"
                android:paddingEnd="16dp"
                android:text="適用　"
                android:textAlignment="textStart"
                android:textColor="@color/color_text" />
            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:foreground="@drawable/btn_apply" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/FontCancelFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="0dp">
            <Button
                android:id="@+id/FontCancelButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="42dp"
                android:paddingEnd="16dp"
                android:backgroundTint="@color/button_color_selector"
                android:text="閉じる"
                android:textAlignment="textStart"
                android:textColor="@color/color_text" />
            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:foreground="@drawable/btn_close" />
        </FrameLayout>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ﾌｫﾝﾄｻｲｽﾞ"
        android:textSize="25sp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="0dp"/>

    <EditText
        android:id="@+id/FontSizeEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:background="@drawable/border_corner_radius"
        android:saveEnabled="false"
        android:gravity="start|top"
        android:inputType="number"
        android:maxLines="1"
        android:minHeight="48dp"
        android:text="30"
        android:textSize="30sp"
        android:hint="10～60"
        android:textColorHint="@color/color_hint"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"/>

</LinearLayout>