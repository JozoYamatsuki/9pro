<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <Button
        android:id="@+id/PageAddButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="0dp"
        android:backgroundTint="#E6E6FF"
        android:text="このページの次にページを追加する"
        android:textAlignment="textStart"
        android:textColor="#000000" />

    <Button
        android:id="@+id/PageRepButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="0dp"
        android:backgroundTint="#E6E6FF"
        android:text="このページと次のページを入れ替える"
        android:textAlignment="textStart"
        android:textColor="#000000" />

    <Button
        android:id="@+id/PageDelButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="0dp"
        android:backgroundTint="#E6E6FF"
        android:text="このページを削除する"
        android:textAlignment="textStart"
        android:textColor="#000000" />

    <Button
        android:id="@+id/PageExitButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#E6E6FF"
        android:text="閉じる"
        android:textColor="#000000" />

</LinearLayout>