<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_mainBG"
    tools:context=".MainActivity">

    <FrameLayout
        android:id="@+id/SaveFrameLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/SaveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/button_color_selector"
            android:onClick="onSaveButton"
            android:paddingStart="42dp"
            android:paddingEnd="16dp"
            android:text="上書保存"
            android:textColor="@color/color_text" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:foreground="@drawable/btn_save" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/LoadFrameLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/LoadButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/button_color_selector"
            android:onClick="onLoadButton"
            android:paddingStart="42dp"
            android:paddingEnd="16dp"
            android:text="変更破棄"
            android:textColor="@color/color_text" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:foreground="@drawable/btn_load" />

    </FrameLayout>

    <TextView
        android:id="@+id/InformationTextView"
        android:layout_width="0dp"
        android:layout_height="48sp"
        android:background="@color/color_textBG"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/UpdateTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="　"
        android:textColor="@color/color_update"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/EditViewPager2"
        app:layout_constraintStart_toEndOf="@+id/PageTextView"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/UpdatePageTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="　"
        android:textColor="@color/color_update"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/EditViewPager2"
        app:layout_constraintStart_toEndOf="@+id/UpdateTextView"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/UnderLinearLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/color_mainBG"
        android:focusableInTouchMode="true"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/InformationTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/BeforeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/button_color_selector"
            android:foreground="@drawable/btn_left"
            android:onClick="onBeforeButton"
            android:contentDescription="←" />

        <Button
            android:id="@+id/NextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/button_color_selector"
            android:foreground="@drawable/btn_right"
            android:onClick="onNextButton"
            android:contentDescription="→" />

        <Button
            android:id="@+id/TopButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/button_color_selector"
            android:foreground="@drawable/btn_top"
            android:onClick="onTopButton"
            android:contentDescription="↑" />

        <Button
            android:id="@+id/BottomButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/button_color_selector"
            android:foreground="@drawable/btn_bottom"
            android:onClick="onBottomButton"
            android:contentDescription="↓" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <Button
            android:id="@+id/PageSupportButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/color_mainBG"
            android:foreground="@drawable/button_image_selector"
            android:onClick="onPageSupportButton"
            android:contentDescription="ページサポート" />

    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/EditViewPager2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/color_textBG"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/UnderLinearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/SaveFrameLayout" />

    <TextView
        android:id="@+id/PageTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:onClick="onPageTextView"
        android:text="1"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/EditViewPager2"
        app:layout_constraintEnd_toStartOf="@+id/LoadFrameLayout"
        app:layout_constraintStart_toEndOf="@+id/SaveFrameLayout"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>