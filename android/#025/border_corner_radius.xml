<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <!-- 枠線の太さと色 -->
            <stroke
                android:width="1dp"
                android:color="#808080" />
            <!-- 角丸（半径を指定） -->
            <corners android:radius="10dp"/>
            <!-- 背景色 -->
            <solid android:color="#E6E6FF" />
        </shape>
    </item>
</layer-list>