<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6E6FF"
    android:orientation="vertical">

    <TextView
        android:id="@+id/PageRightTitleTextView"
        android:background="@drawable/border_corner_radius"
        android:gravity="start|top"
        android:textSize="30sp"
        android:maxLines="1"
        android:text=""
        android:hint="ページタイトル"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/PageRightTextView"
        android:background="@drawable/border_left_and_right"
        android:gravity="start|top"
        android:textSize="30sp"
        android:text=""
        android:hint="メモ"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>